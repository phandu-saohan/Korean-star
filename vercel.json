{
  "rewrites": [
    {
      "source": "/api/zalo/webhook",
      "destination": "/api/zalo/webhook"
    },
    {
      "source": "/api/zalo/set-webhook",
      "destination": "/api/zalo/set-webhook"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
